#!/usr/bin/env python3

import os
import sys
import re
import argparse
from datetime import datetime

def main():
    parser = argparse.ArgumentParser(description='Superpowered history utility - lists commands run in current $PWD at any time by any shell')
    parser.add_argument('-a', '--all', action='store_true', help='Show all commands from all directories')
    parser.add_argument('-n', '--number', type=int, default=20, help='Show only last N commands (default: 20)')
    parser.add_argument('-f', '--file', help='Show commands from specific file instead of default log')
    parser.add_argument('-r', '--regex', help='Filter commands using regex pattern')
    parser.add_argument('-h', '--help', action='help', help='Show this help message')
    
    args = parser.parse_args()
    
    # Determine log file
    if args.file:
        log_file = args.file
    else:
        log_file = os.path.expanduser('~/.shell_history.log')
    
    # Check if log file exists
    if not os.path.exists(log_file):
        print(f"No shell history log found at {log_file}")
        sys.exit(1)
    
    # Read all lines from log file
    with open(log_file, 'r') as f:
        lines = f.readlines()
    
    # Filter lines based on arguments
    current_dir = os.getcwd()
    filtered_lines = []
    
    for line in lines:
        if args.all:
            # Show all commands
            filtered_lines.append(line.strip())
        else:
            # Show only commands from current directory
            if f" | {current_dir} | " in line:
                filtered_lines.append(line.strip())
    
    # Apply regex filter if provided
    if args.regex:
        try:
            pattern = re.compile(args.regex)
            filtered_lines = [line for line in filtered_lines if pattern.search(line)]
        except re.error as e:
            print(f"Invalid regex pattern: {e}")
            sys.exit(1)
    
    # Show last N commands
    lines_to_show = filtered_lines[-args.number:]
    
    for line in lines_to_show:
        print(line)

if __name__ == "__main__":
    main()
